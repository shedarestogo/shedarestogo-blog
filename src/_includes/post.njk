---
layout: base.njk
---
<article class="post wrap-narrow">
  {% if sample %}
  <div class="sample-banner">
    <strong>SAMPLE DRAFT.</strong> This post is a placeholder so you can see how posts look. Rewrite it in your voice or delete it.
  </div>
  {% endif %}
  <p class="kicker">{{ tags | join(", ") }}</p>
  <h1>{{ title }}</h1>
  <p class="meta">{{ date | readableDate }} · by {{ site.author }}</p>
  {% if image %}
  <img class="post-hero-img" src="{{ image }}" alt="{{ title }}" />
  {% endif %}
  <div class="post-body">
    {{ content | safe }}
  </div>
  {% include "cta.njk" %}
</article>
